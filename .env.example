# Optional. Set in Vercel environment settings; never expose in NEXT_PUBLIC variables.
FINNHUB_API_KEY=
# Server-side SEC EDGAR request identity. Use an authorized contact email; do not prefix NEXT_PUBLIC.
SEC_USER_AGENT="Zentai Networks Research contact@example.com"

# Optional private FP&A snapshot storage. Use a Supabase publishable/anon key, never a service-role key.
# Apply supabase/migrations/20261020000000_fpa_snapshots.sql and enable email sign-in first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
